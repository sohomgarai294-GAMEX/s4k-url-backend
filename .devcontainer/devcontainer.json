{
  "name": "S.4K URL Backend",
  "image": "mcr.microsoft.com/devcontainers/python:3.12",
  "features": {
    "ghcr.io/devcontainers/features/sshd:1": { "version": "latest" }
  },
  "postCreateCommand": "sudo apt-get update -qq && sudo apt-get install -y -qq ffmpeg && python3 -m pip install -q -r requirements.txt",
  "postStartCommand": "nohup bash start.sh > /tmp/s4k-api.log 2>&1 &",
  "forwardPorts": [8080],
  "portsAttributes": {
    "8080": {
      "label": "S.4K API",
      "visibility": "public",
      "onAutoForward": "silent",
      "protocol": "http"
    }
  },
  "otherPortsAttributes": { "onAutoForward": "ignore" }
}
